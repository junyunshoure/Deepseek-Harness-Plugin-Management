    "manifest": "payload/services/manifest.json",
    "required": false,
    "installer": "SETUP-SERVICES.cmd"
  },
  "modes": {
    "new": "仅允许空壳 profile（没有第三方 bundle / 依赖）",
    "merge": "只补缺失，不覆盖已存在的同名包（默认推荐）",
    "backup": "全部备份后覆盖成本包版本"
  },
  "docs": {
    "readme": "README.md",
    "manual": "docs/使用说明书.md",
    "features": "docs/新功能说明.md",
    "config": "docs/配置参考.md",
    "faq": "docs/常见问题.md",
