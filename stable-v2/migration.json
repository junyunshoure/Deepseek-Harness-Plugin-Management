    "aiAgent": "docs/AI-agent-适配指南.md",
    "macos": "macos/INSTALL-MAC.md"
  },
  "packVersion": "2.1.1",
  "mode": 2,
  "supportedModes": [
    "new",
    "merge",
    "backup",
    "upgrade",
    "repair"
  ],
  "storeLayout": "%LOCALAPPDATA%\\DSHPluginsPack\\v<version>-windows"
